{
	"name": "consensus",
	"version": "0.5.1",
	"description": "Collaborative plan building and approval: the User and the LLM work a draft through, thread by thread, until it is approved as an actionable Plan.",
	"private": true,
	"license": "MIT",
	"main": "src/Server.js",
	"scripts": {
		"start": "node bin/consensus.js",
		"test": "node --test",
		"desktop": "electron desktop",
		"smoke": "node bin/smoke.js",
		"dist": "electron-builder --win nsis"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"angular": "^1.8.3",
		"bootstrap": "^5.3.8",
		"express": "^5.1.0",
		"marked": "^18.0.0",
		"monaco-editor": "0.56.0"
	},
	"bin": {
		"consensus": "bin/consensus.js"
	},
	"devDependencies": {
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3"
	},
	"build": {
		"appId": "com.mchiver.consensus",
		"productName": "Consensus",
		"artifactName": "${productName}-Setup-${version}.${ext}",
		"extraMetadata": {
			"main": "desktop/main.js"
		},
		"directories": {
			"output": "~dist"
		},
		"files": [
			"desktop/**",
			"src/**",
			"public/**",
			".guides/build-with-consensus.md",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "desktop/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"include": "build/installer.nsh"
		}
	}
}
